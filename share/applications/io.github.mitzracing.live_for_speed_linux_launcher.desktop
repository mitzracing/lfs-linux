[Desktop Entry]
Type=Application
Name=Live for Speed Linux Launcher
GenericName=Racing Simulator Launcher
Comment=Run Live for Speed on Linux with verified Wine and DXVK files
Exec=lfs-linux-desktop launch
TryExec=lfs-linux-desktop
Icon=io.github.mitzracing.live_for_speed_linux_launcher
Terminal=false
StartupNotify=true
StartupWMClass=lfs.exe
Categories=Game;Simulation;
Keywords=racing;simulator;wine;LFS;
PrefersNonDefaultGPU=true
Actions=Install;Doctor;

[Desktop Action Install]
Name=Install or Repair LFS
Exec=lfs-linux-desktop setup

[Desktop Action Doctor]
Name=Check Live for Speed Linux Launcher
Exec=lfs-linux-desktop doctor
