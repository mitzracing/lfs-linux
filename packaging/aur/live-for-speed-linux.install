post_install() {
  printf '%s\n' \
    'Live for Speed Linux installed the open-source launcher only.' \
    'Open Live for Speed Linux for one-time verified setup.' \
    'CLI alternative: lfs-linux setup'
}

post_upgrade() {
  printf '%s\n' \
    'Live for Speed Linux upgraded; player data was preserved.' \
    'The next application launch offers setup only when audited pins or Wine changed.'
}

pre_remove() {
  printf '%s\n' \
    'Package removal preserves ~/.local/share/lfs-linux by design.' \
    'For full removal, cancel now and run as your desktop user: lfs-linux remove'
}
