pkgname=live-for-speed-launcher
pkgver=0.1.2
pkgrel=1
pkgdesc='Unofficial community Linux launcher for Live for Speed'
arch=('x86_64')
url='https://github.com/mitzracing/live-for-speed-linux-launcher'
license=('MIT')
provides=('lfs-linux')
conflicts=('lfs-linux')
replaces=('lfs-linux')
depends=(
  '7zip'
  'bash'
  'coreutils'
  'curl'
  'desktop-file-utils'
  'findutils'
  'gawk'
  'grep'
  'libarchive'
  'libpulse'
  'sed'
  'tar'
  'util-linux'
  'vulkan-icd-loader'
  'vulkan-driver'
  'wine=11.15-1'
  'xdotool'
  'xterm'
)
optdepends=(
  'libnotify: desktop launch error notifications'
  'vulkan-tools: detailed Vulkan diagnostics'
  'wmctrl: focus an existing LFS window'
)
install=live-for-speed-launcher.install
_source_name='live-for-speed-linux-launcher'
source=("$_source_name-$pkgver.tar.gz::$url/releases/download/v$pkgver/$_source_name-$pkgver.tar.gz")
sha256sums=('d929eb83fa3e7fab4479dfabb30714fd2a6725e888ee104f39062b0732f52bde')

package() {
  cd "$srcdir/$_source_name-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
